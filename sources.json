{
  "version": "1.0",
  "description": "轩轩音乐音源配置（运行时加载）。只保留实测能返回真实搜索结果的源；失效源一经确认即整条删除，不保留占位。",
  "sources": [
    {
      "id": "netease",
      "name": "网易云",
      "searchUrl": "https://music.163.com/api/cloudsearch/pc?s={keyword}&type=1&limit=50",
      "playUrlTemplate": "https://music.163.com/api/song/enhance/player/url/v1?ids=[{id}]&level=standard&encodeType=mp3",
      "lyricUrlTemplate": "https://music.163.com/api/song/lyric?id={id}&lv=1&kv=1&tv=1",
      "enabled": true,
      "priority": 15,
      "type": "DIRECT",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "Referer": "https://music.163.com",
        "Cookie": "appver=2.0.2"
      }
    },
    {
      "id": "netease2",
      "name": "网易云备用",
      "searchUrl": "https://music.163.com/api/cloudsearch/pc?s={keyword}&type=1&limit=30",
      "playUrlTemplate": "https://music.163.com/api/song/enhance/player/url/v1?ids=[{id}]&level=standard&encodeType=mp3",
      "lyricUrlTemplate": "https://music.163.com/api/song/lyric/v1?id={id}&lv=1&kv=1&tv=1",
      "enabled": true,
      "priority": 10,
      "type": "DIRECT",
