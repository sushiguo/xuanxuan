        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "Referer": "https://music.163.com",
        "Cookie": "appver=8.7.01"
      }
    },
    {
      "id": "qq",
      "name": "QQ音乐",
      "searchUrl": "https://c.y.qq.com/soso/fcgi-bin/client_search_cp?w={keyword}&n=20&format=json",
      "playUrlTemplate": "https://u.y.qq.com/cgi-bin/musicu.fcg?data=%7B%22req_0%22%3A%7B%22module%22%3A%22vkey.GetVkeyServer%22%2C%22method%22%3A%22CgiGetVkey%22%2C%22param%22%3A%7B%22guid%22%3A%220%22%2C%22songmid%22%3A%5B%22{id}%22%5D%2C%22songtype%22%3A%5B0%5D%2C%22uin%22%3A%220%22%2C%22loginflag%22%3A1%2C%22platform%22%3A%2220%22%7D%7D%7D",
      "lyricUrlTemplate": "https://c.y.qq.com/lyric/fcgi-bin/fcg_query_lyric_new.fcg?songmid={id}&g_tk=5381&loginUin=0&hostUin=0&format=json&inCharset=utf8&outCharset=utf-8&notice=0&platform=yqq&needNewCode=0",
      "enabled": true,
      "priority": 90,
      "type": "DIRECT",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "Referer": "https://y.qq.com"
      }
    },
    {
      "id": "kugou",
      "name": "酷狗",
      "searchUrl": "https://songsearch.kugou.com/song_search_v2?keyword={keyword}&page=1&pagesize=20&format=json",
      "playUrlTemplate": "https://m.kugou.com/app/i/getSongInfo.php?cmd=playInfo&hash={id}",
      "lyricUrlTemplate": "",
